# Skopiuj na VPS jako .env w tym samym katalogu co docker-compose.yml:
#   cp env.example .env && nano .env
#
# IMAGE — ten sam tag co w GitHub Actions (repo: Dmytro-Potapchuk/sofia-art-site)
IMAGE=ghcr.io/dmytro-potapchuk/sofia-art-site:latest

# Port na hoście (80 = http, 443 wymaga reverse proxy z SSL)
HTTP_PORT=80
