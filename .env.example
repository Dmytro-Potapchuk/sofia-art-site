# Pobierz darmowy klucz na https://web3forms.com (wpisz sophiabeshlei@gmail.com)
# Skopiuj ten plik jako .env.local i wklej klucz:
REACT_APP_WEB3FORMS_ACCESS_KEY=

# Supabase — https://supabase.com/dashboard (Project Settings → API)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Migracja SQL: supabase/sql-editor-setup.sql (SQL Editor → Run)

# --- Docker (lokalnie) ---
# Skopiuj jako .env w katalogu projektu: cp .env.example .env
# docker compose up --build  →  http://localhost:8080

# --- GitHub Actions (Settings → Secrets and variables → Actions) ---
# REACT_APP_SUPABASE_URL, REACT_APP_SUPABASE_ANON_KEY, REACT_APP_WEB3FORMS_ACCESS_KEY
# VPS_HOST, VPS_USER, VPS_SSH_KEY, VPS_DEPLOY_PATH (np. /opt/sofia-art)
# VPS_SSH_PORT (opcjonalnie, domyślnie 22)
# GHCR_TOKEN (opcjonalnie — PAT z read:packages, jeśli obraz GHCR jest prywatny)
